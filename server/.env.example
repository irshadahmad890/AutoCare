# Django
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL locally, or PostgreSQL for the free Supabase + Render deployment.
# For Supabase set DB_ENGINE=django.db.backends.postgresql and use its connection values.
DB_ENGINE=django.db.backends.mysql
DB_NAME=autocare
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Comma-separated origins for the independently deployed frontend
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
